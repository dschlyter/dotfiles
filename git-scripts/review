#!/bin/bash

# Set up a branch in review state
# Makes branch changes into uncommitted changes for reviewing with full IDE access.

set -eu
IFS=$'\n'

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || "${1:-}" == "help" ]]; then
    echo "Usage: git review [branch]"
    echo ""
    echo "Review a branch with full IDE access by showing branch changes as uncommitted."
    echo ""
    echo "  git review              On master: pick branch with fzf. On a branch: review it."
    echo "  git review <branch>     Review the given branch."
    echo "  git review              On a review-* branch: exit review, return to original branch."
    echo "                          Any edits made during review are kept as unstaged changes."
    exit 0
fi

current=$(git branch --show-current)

# If on a review branch, exit review mode
if [[ "$current" == review-* ]]; then
    original="${current#review-}"
    git reset "$original"
    git checkout "$original"
    git branch -D "$current"
    exit 0
fi

test -z "$(git status --porcelain)" || (echo "Uncommitted changes"; exit 1)


if [[ -n "${1:-}" ]]; then
    branch="$1"
elif [[ "$current" != "master" ]]; then
    branch="$current"
else
    git fetch
    branch="$(git braf)"
fi

# Strip remote prefix for review branch name
ref="$branch"
branch="${branch#origin/}"
review_branch="review-$branch"

git checkout master
git branch -f "$review_branch" "$ref"
git switch "$review_branch"
git merge master -m "tmp merge"

# reset to master to make changes into uncommitted changes
git reset master

# add all new files as "intend to commit" to fix IDE highlight
git add -N .
