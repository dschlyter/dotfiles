#!/bin/bash

# git swt - switch (sparse) worktree
# Built to stay fast in huge monorepos: avoids full checkouts and repo-wide scans.

usage() {
    cat <<'EOF'
Usage: git swt [-c] [branch-name] [-d] [-m | -l | -r]

Switch to a new worktree, or back from one. Prints the target dir on the last line,
for use with: cd "$(git swt)"

Create (when not in a worktree):
  git swt              Move current branch to worktree.
                       Main switches to master (fails on master, use -c)
  git swt <branch>     Move existing branch to worktree, or go to it if it exists
  git swt -c [name]    Create new branch from master in worktree (default name: worktree2, 3, ...)

  When run from a subdir of a large repo, the worktree is a sparse checkout of that subdir.

  With uncommitted changes, one of these is required:
  -m, --move           Move the changes to the worktree
  -l, --leave          Leave the changes in the main repo

Remove (when in a worktree):
  git swt              Remove worktree, check out its branch in main repo
                       (fails if main repo has uncommitted changes)
  git swt -d           Done: remove worktree, keep branch, leave main repo as is

  With uncommitted changes, one of these is required:
  -m, --move           Move the changes back to the main repo (not with -d)
  -r, --reset          Discard the changes
EOF
}

set -euo pipefail

# repos with an index smaller than this get a full checkout (~100 bytes per file)
SMALL_INDEX_BYTES=$((2 * 1024 * 1024))

main() {
    CHANGES=""
    CREATE=false
    DONE=false
    BRANCH_ARG=""
    for arg in "$@"; do
        case "$arg" in
            -m|--move) set_changes move ;;
            -l|--leave) set_changes leave ;;
            -r|--reset) set_changes reset ;;
            -c|--create) CREATE=true ;;
            -d|--done) DONE=true ;;
            -h|--help) usage; exit 0 ;;
            -*) echo "Unknown option: $arg" >&2; exit 1 ;;
            *)
                if [[ -n "$BRANCH_ARG" ]]; then
                    echo "Error: unexpected argument '$arg'" >&2
                    exit 1
                fi
                BRANCH_ARG="$arg"
                ;;
        esac
    done

    # git exports GIT_DIR to aliases in worktrees, it would leak into the git -C calls below
    unset GIT_DIR GIT_WORK_TREE
    DOT_GIT=$(cd "$(git rev-parse --git-dir)" && pwd)
    COMMON_DIR=$(cd "$(git rev-parse --git-common-dir)" && pwd)
    SUBDIR=$(git rev-parse --show-prefix)
    SUBDIR="${SUBDIR%/}"

    if [[ "$DOT_GIT" != "$COMMON_DIR" ]]; then
        remove_worktree
    elif [[ "$DONE" == true ]]; then
        echo "Error: -d only works inside a worktree" >&2
        exit 1
    else
        create_worktree
    fi
}

remove_worktree() {
    if [[ -n "$BRANCH_ARG" || "$CREATE" == true ]]; then
        echo "Error: branch arguments not supported when removing a worktree" >&2
        exit 1
    fi

    if [[ "$CHANGES" == leave ]]; then
        echo "Error: --leave is not valid when removing, the worktree is deleted. Use -m to move or -r to discard" >&2
        exit 1
    fi
    if [[ "$CHANGES" == move && "$DONE" == true ]]; then
        echo "Error: -m moves changes onto the branch in the main repo, it does not combine with -d" >&2
        exit 1
    fi

    local worktree_root main_root branch carry=false
    worktree_root=$(git rev-parse --show-toplevel)
    main_root=$(dirname "$COMMON_DIR")
    branch=$(git rev-parse --abbrev-ref HEAD)

    if is_dirty . && [[ -z "$CHANGES" ]]; then
        echo "Error: worktree has uncommitted changes. Commit them, or pass -m to move or -r to discard" >&2
        exit 1
    fi

    if [[ "$DONE" != true ]] && is_dirty "$main_root"; then
        echo "Error: main repo $main_root has uncommitted changes, not moving back. Use -d to just remove the worktree" >&2
        exit 1
    elif [[ "$CHANGES" == move ]] && is_dirty .; then
        echo "Stashing changes to move them back..." >&2
        git stash push -u -m "swt: $branch" >&2
        carry=true
    fi

    echo "Removing worktree for '$branch'..." >&2
    if [[ "$CHANGES" == reset ]]; then
        git -C "$main_root" -c advice.sparseIndexExpanded=false worktree remove --force "$worktree_root"
    else
        git -C "$main_root" -c advice.sparseIndexExpanded=false worktree remove "$worktree_root"
    fi

    if [[ "$DONE" != true && "$branch" != "HEAD" ]]; then
        if ! git -C "$main_root" checkout "$branch" >&2; then
            echo "Warning: could not check out '$branch' in $main_root" >&2
            [[ "$carry" == true ]] && echo "Warning: changes are left in the stash, restore with: git stash pop" >&2
        elif [[ "$carry" == true ]]; then
            git -C "$main_root" stash pop >&2
        fi
    fi

    echo "$main_root${SUBDIR:+/$SUBDIR}"
}

create_worktree() {
    local repo_root current_branch wt_parent branch sparse=false carry=false
    repo_root=$(git rev-parse --show-toplevel)
    current_branch=$(git rev-parse --abbrev-ref HEAD)

    if [[ -d "$repo_root/.claude/worktrees" ]]; then
        wt_parent="$repo_root/.claude/worktrees"
    else
        wt_parent="$repo_root/worktrees"
    fi

    if [[ -z "$BRANCH_ARG" && "$CREATE" != true ]]; then
        if [[ "$current_branch" == "master" || "$current_branch" == "HEAD" ]]; then
            echo "Error: nothing to move on $current_branch, use -c to create a new branch" >&2
            exit 1
        fi
        BRANCH_ARG="$current_branch"
    fi
    branch="${BRANCH_ARG:-$(next_worktree_name "$wt_parent")}"

    local wt_dir="$wt_parent/$branch"
    if [[ -d "$wt_dir" ]]; then
        echo "Worktree for '$branch' already exists" >&2
        if [[ -d "$wt_dir/$SUBDIR" ]]; then echo "$wt_dir${SUBDIR:+/$SUBDIR}"; else echo "$wt_dir"; fi
        return
    fi

    if [[ "$CHANGES" == reset ]]; then
        echo "Error: --reset only works when removing a worktree, use -m or -l" >&2
        exit 1
    fi
    if is_dirty . && [[ -z "$CHANGES" ]]; then
        echo "Error: uncommitted changes, pass -m to move them to the worktree or -l to leave them" >&2
        exit 1
    fi

    [[ -n "$SUBDIR" ]] && ! is_small_repo && sparse=true

    if [[ "$CREATE" == true ]] && branch_exists "$branch"; then
        echo "Error: branch '$branch' already exists, drop -c to move it" >&2
        exit 1
    elif [[ "$CREATE" != true ]] && ! branch_exists "$branch"; then
        echo "Error: branch '$branch' does not exist, use -c to create it" >&2
        exit 1
    fi

    if [[ "$CHANGES" == move ]] && is_dirty .; then
        if [[ "$sparse" == true ]] && is_dirty . ":(top,exclude)$SUBDIR"; then
            echo "Error: uncommitted changes outside $SUBDIR would not fit in the sparse worktree, commit or stash them" >&2
            exit 1
        fi
        echo "Stashing changes to move them to the worktree..." >&2
        git stash push -u -m "swt: $branch" >&2
        carry=true
    fi

    if [[ "$CREATE" == true ]]; then
        echo "Creating branch '$branch' from master..." >&2
        git branch "$branch" master
    elif [[ "$branch" == "$current_branch" ]]; then
        # the branch moves to the worktree, main switches to master (left changes come along)
        echo "Switching main repo to master..." >&2
        git checkout master >&2
    fi

    mkdir -p "$wt_parent"
    exclude_dir "${wt_parent#"$repo_root"/}"

    if [[ "$sparse" == true ]]; then
        echo "Creating sparse worktree for '$branch' ($SUBDIR)..." >&2
        git worktree add --no-checkout --detach "$wt_dir" >&2
        git -C "$wt_dir" sparse-checkout set --sparse-index "$SUBDIR" >&2
        git -C "$wt_dir" checkout "$branch" >&2
    else
        echo "Creating worktree for '$branch'..." >&2
        git worktree add "$wt_dir" "$branch" >&2
    fi

    if [[ "$carry" == true ]]; then
        git -C "$wt_dir" stash pop >&2
    fi

    echo "$wt_dir${SUBDIR:+/$SUBDIR}"
}

set_changes() {
    if [[ -n "$CHANGES" && "$CHANGES" != "$1" ]]; then
        echo "Error: -m, -l and -r are mutually exclusive" >&2
        exit 1
    fi
    CHANGES="$1"
}

# lists dirs instead of asking git, which is slow in huge repos
next_worktree_name() {
    local parent="$1" n=2
    while [[ -e "$parent/worktree$n" ]] || branch_exists "worktree$n"; do
        n=$((n + 1))
    done
    echo "worktree$n"
}

# is_dirty <dir> [pathspec...] - any uncommitted or untracked changes
is_dirty() {
    local dir="$1"
    shift
    [[ -n "$(git -C "$dir" status --porcelain -- "$@")" ]]
}

# keep the worktree dir out of status and stash -u in the main repo
exclude_dir() {
    local exclude="$COMMON_DIR/info/exclude" line="/$1/"
    grep -qxF "$line" "$exclude" 2>/dev/null && return
    mkdir -p "$COMMON_DIR/info"
    echo "$line" >> "$exclude"
}

branch_exists() {
    git rev-parse --verify --quiet "refs/heads/$1" >/dev/null
}

# index size is a cheap proxy for file count. a sparse main repo has a shrunken index, so never count it as small
is_small_repo() {
    [[ "$(git config --bool core.sparseCheckout || true)" != "true" ]] || return 1
    local size
    size=$(stat -c %s "$DOT_GIT/index" 2>/dev/null || stat -f %z "$DOT_GIT/index")
    [[ "$size" -lt "$SMALL_INDEX_BYTES" ]]
}

main "$@"
