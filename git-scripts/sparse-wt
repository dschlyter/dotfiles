#!/bin/bash

# git sparse-wt [branch-name] [--reset]
# Create or remove a sparse worktree for the current subdirectory.
#
# Create (not in a worktree):
#   git sparse-wt              Move current branch to worktree, switch main to master
#   git sparse-wt <new-branch> Create new branch from master in worktree
#   git sparse-wt <existing>   Move existing branch to worktree, leave main unchanged
#
# Remove (in a worktree):
#   git sparse-wt              Remove worktree (fails if uncommitted changes)
#   git sparse-wt --reset      Remove worktree, discard uncommitted changes
#
# Outputs the target directory path on the last line (for use with cd).

set -euo pipefail

RESET=false
BRANCH_ARG=""
for arg in "$@"; do
    case "$arg" in
        --reset) RESET=true ;;
        -h|--help)
            cat <<'EOF'
Usage: git sparse-wt [branch-name] [--reset]

Create or remove a sparse worktree for the current subdirectory.

Create (when not in a worktree):
  git sparse-wt              Move current branch to worktree, switch main to master
  git sparse-wt <new-branch> Create new branch from master in worktree
  git sparse-wt <existing>   Move existing branch to worktree, leave main unchanged

Remove (when in a worktree):
  git sparse-wt              Remove worktree (fails if uncommitted changes)
  git sparse-wt --reset      Remove worktree, discard uncommitted changes

Outputs the target directory path on the last line (for use with: cd "$(git sparse-wt)")
EOF
            exit 0
            ;;
        -*)
            echo "Unknown option: $arg" >&2
            exit 1
            ;;
        *)
            if [[ -n "$BRANCH_ARG" ]]; then
                echo "Error: unexpected argument '$arg'" >&2
                exit 1
            fi
            BRANCH_ARG="$arg"
            ;;
    esac
done

GIT_DIR=$(cd "$(git rev-parse --git-dir)" && pwd)
GIT_COMMON_DIR=$(cd "$(git rev-parse --git-common-dir)" && pwd)

if [[ "$GIT_DIR" != "$GIT_COMMON_DIR" ]]; then
    # === REMOVE MODE ===

    if [[ -n "$BRANCH_ARG" ]]; then
        echo "Error: branch argument not supported when removing a worktree" >&2
        exit 1
    fi

    if [[ "$RESET" != true ]] && [[ -n "$(git status --porcelain)" ]]; then
        echo "Error: worktree has uncommitted changes. Use --reset to discard." >&2
        exit 1
    fi

    WORKTREE_ROOT=$(git rev-parse --show-toplevel)
    SUBDIR=$(git rev-parse --show-prefix)
    SUBDIR="${SUBDIR%/}"

    MAIN_REPO_ROOT=$(dirname "$GIT_COMMON_DIR")
    BRANCH=$(git rev-parse --abbrev-ref HEAD)

    echo "Removing worktree for '$BRANCH'..." >&2

    if [[ "$RESET" == true ]]; then
        git -C "$MAIN_REPO_ROOT" worktree remove --force "$WORKTREE_ROOT"
    else
        git -C "$MAIN_REPO_ROOT" worktree remove "$WORKTREE_ROOT"
    fi

    echo "Removed." >&2

    if [[ -n "$SUBDIR" ]]; then
        echo "$MAIN_REPO_ROOT/$SUBDIR"
    else
        echo "$MAIN_REPO_ROOT"
    fi
else
    # === CREATE MODE ===

    REPO_ROOT=$(git rev-parse --show-toplevel)
    CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    SUBDIR=$(git rev-parse --show-prefix)
    SUBDIR="${SUBDIR%/}"

    if [[ "$CURRENT_BRANCH" == "master" ]] && [[ -z "$BRANCH_ARG" ]]; then
        echo "Error: on master, a branch name argument is required." >&2
        exit 1
    fi

    # Determine branch and whether to switch main repo
    SWITCH_MAIN=false
    if [[ -z "$BRANCH_ARG" ]]; then
        BRANCH="$CURRENT_BRANCH"
        SWITCH_MAIN=true
    elif git rev-parse --verify "$BRANCH_ARG" >/dev/null 2>&1; then
        BRANCH="$BRANCH_ARG"
        if [[ "$BRANCH" == "$CURRENT_BRANCH" ]]; then
            SWITCH_MAIN=true
        fi
    else
        echo "Creating branch '$BRANCH_ARG' from master..." >&2
        git branch "$BRANCH_ARG" master
        BRANCH="$BRANCH_ARG"
    fi

    # Worktree location
    if [[ -d "$REPO_ROOT/.claude/worktrees" ]]; then
        WORKTREE_DIR="$REPO_ROOT/.claude/worktrees/$BRANCH"
    else
        WORKTREE_DIR="$REPO_ROOT/worktrees/$BRANCH"
        mkdir -p "$REPO_ROOT/worktrees"
    fi

    if [[ -d "$WORKTREE_DIR" ]]; then
        echo "Error: worktree already exists at $WORKTREE_DIR" >&2
        exit 1
    fi

    # Switch main repo away from the branch before creating worktree
    if [[ "$SWITCH_MAIN" == true ]]; then
        echo "Switching main repo to master..." >&2
        git checkout master
    fi

    echo "Creating sparse worktree for '$BRANCH'..." >&2
    git worktree add --no-checkout --detach "$WORKTREE_DIR"

    if [[ -n "$SUBDIR" ]]; then
        git -C "$WORKTREE_DIR" sparse-checkout set "$SUBDIR"
    fi

    git -C "$WORKTREE_DIR" checkout "$BRANCH"

    if [[ -n "$SUBDIR" ]]; then
        echo "$WORKTREE_DIR/$SUBDIR"
    else
        echo "$WORKTREE_DIR"
    fi
fi
